<?xml version="1.0" encoding="UTF-8"?>
<!--
    MySQL/InnoDB concurrency tests. Never add these tests to phpunit.xml.

    Every value below belongs to a disposable local container and is not a secret. No .env file is
    read, and ConcurrencyDatabaseGuard refuses any other host, port, or database name.

    See tests/Support/Concurrency/ConcurrencyHarness.php for how to start the database.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheResult="false"
>
    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:Y29uY3VycmVuY3ktdGVzdC1rZXktbm90LXNlY3JldCE=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="APP_TIMEZONE" value="Asia/Tokyo" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="33307" force="true"/>
        <env name="DB_DATABASE" value="tarot_ec_concurrency_test" force="true"/>
        <env name="DB_USERNAME" value="concurrency" force="true"/>
        <env name="DB_PASSWORD" value="concurrency" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="STRIPE_SECRET" value="" force="true"/>
        <env name="EC_STRIPE_SECRET" value="" force="true"/>
        <env name="EC_ENABLED" value="true" force="true"/>
    </php>
</phpunit>
